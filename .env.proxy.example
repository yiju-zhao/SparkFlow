# ===========================================================================
# Server-only: corporate proxy + TLS-MITM CA bundle vars
# ===========================================================================
# Copy to .env.proxy on the server (gitignored — matches .env*):
#   cp .env.proxy.example .env.proxy
#
# Loaded by docker-compose.server.yml via env_file lists for every
# outbound-talking service (web, workers, workflows-api, semops, …).
#
# On a host WITHOUT a TLS-intercepting proxy: leave the file in place
# but the values are harmless — SSL_CERT_FILE pointing at the
# system bundle is the standard system path; NO_PROXY just lists
# docker network names so library-level proxy code skips them.
#
# Note: a corresponding ./ca-certificates.crt MUST exist at repo root
# (the file the volumes: blocks bind-mount). On non-MITM hosts you can
# `touch ca-certificates.crt` to create an empty placeholder.

# ---------------------------------------------------------------------------
# NO_PROXY — keep ALL docker service hostnames here so HTTP_PROXY auto-
# injected by ~/.docker/config.json doesn't route inter-container traffic
# through the host proxy. Append your corporate intranet domains as needed.
# ---------------------------------------------------------------------------
NO_PROXY=localhost,127.0.0.1,postgres,redis,searxng,semops,web,workflows-api,ingest-worker,digest-worker,migrate
no_proxy=localhost,127.0.0.1,postgres,redis,searxng,semops,web,workflows-api,ingest-worker,digest-worker,migrate

# ---------------------------------------------------------------------------
# Corporate CA bundle — paired with the bind-mount of ./ca-certificates.crt
# onto /etc/ssl/certs/ca-certificates.crt in docker-compose.server.yml.
# Three vars cover every TLS code path in the stack:
#   SSL_CERT_FILE       — Python ssl module / OpenSSL CLI
#   REQUESTS_CA_BUNDLE  — `requests` and `httpx`
#   CURL_CA_BUNDLE      — libcurl
# ---------------------------------------------------------------------------
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
