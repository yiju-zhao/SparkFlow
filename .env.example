# ===========================================================================
# Root .env — compose-level meta vars (port mappings + compose-substituted secrets)
# ===========================================================================
# Copy to .env on the server (gitignored — matches .env*):
#   cp .env.example .env
#
# This file is read by `docker compose` for `${VAR}` substitution in
# the compose file itself (port mappings, SEARXNG_SECRET). It is NOT
# loaded into containers — the env_file: directive does that, sourced
# from apps/web/.env / apps/langgraph/.env / .env.proxy.
#
# Why this file exists separately from apps/web/.env:
#   docker compose's ${...} substitution ONLY reads the .env that lives
#   beside the compose file. apps/web/.env is invisible to substitution,
#   only to env_file. Splitting the two roles into two files removes the
#   "set var in apps/web/.env, compose silently uses default" footgun.
#
# Leave any line out → compose uses the default in the compose file
# (`${VAR:-default}`).

# ---------------------------------------------------------------------------
# Host port mappings (host port → container port)
# ---------------------------------------------------------------------------
# Override only when the host already uses the default port.
WEB_PORT=3001
WORKFLOWS_PORT=2027
POSTGRES_PORT=5433
REDIS_PORT=6379
SEARXNG_PORT=8888
SEMOPS_PORT=2025

# ---------------------------------------------------------------------------
# SearXNG secret — substituted into the searxng container's env at parse time
# ---------------------------------------------------------------------------
# Rotate per environment. Default in the compose file is unsafe for prod.
SEARXNG_SECRET=__rotate_per_env__                         # openssl rand -hex 32
