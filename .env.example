# ===========================================================================
# SparkFlow — single .env for production server deploys
# ===========================================================================
# Copy to .env on the server (gitignored):
#   cp .env.example .env
#
# This is the ONLY file you edit on the server. Used by
# docker-compose.server.yml for BOTH:
#   1. ${VAR} substitution at parse time (port mappings, SEARXNG_SECRET)
#   2. Container environment via `env_file: ./.env` on every service
#
# Local-host dev (`npm run dev`, `make serve`) keeps its own per-app
# files: apps/web/.env(.local) for Next.js, apps/langgraph/.env for
# python-dotenv. Docker doesn't read those.
#
# ROTATE every secret per environment:
#   • NEXTAUTH_SECRET, API_KEY_ENCRYPTION_SECRET — `openssl rand -base64 32`
#   • POSTGRES_PASSWORD                          — strong random, NOT `sparkflow`
#   • INTERNAL_CALLBACK_TOKEN, SEARXNG_SECRET    — `openssl rand -hex 32`

# ===========================================================================
# 1. Compose meta — port mappings (host port → container port)
# ===========================================================================
WEB_PORT=3001
WORKFLOWS_PORT=2027
POSTGRES_PORT=5433
REDIS_PORT=6379
SEARXNG_PORT=8888
SEMOPS_PORT=2025

# ===========================================================================
# 2. Authentication (apps/web)
# ===========================================================================
NEXTAUTH_SECRET=__rotate_per_env__                      # openssl rand -base64 32
NEXTAUTH_URL=https://your-public-domain.com             # the URL your users hit
ADMIN_EMAILS=admin@yourcompany.com                      # comma-separated; first login auto-promoted
API_KEY_ENCRYPTION_SECRET=__rotate_per_env__            # openssl rand -base64 32 — encrypts BYOK keys at rest

# ===========================================================================
# 3. Postgres + Database URL
# ===========================================================================
# POSTGRES_USER/PASSWORD/DB initialize the postgres cluster on first boot.
# DATABASE_URL is what every app talks to — uses the docker service hostname.
POSTGRES_USER=sparkflow
POSTGRES_PASSWORD=__strong_random_password__
POSTGRES_DB=sparkflow
DATABASE_URL=postgresql://sparkflow:__strong_random_password__@postgres:5432/sparkflow

# Optional external WeChat Postgres — leave blank to disable
WECHAT_DATABASE_URL=

# LangGraph checkpointer DB — separate database recommended in prod
# (checkpoint churn doesn't fight the main DB's vacuum).
CHECKPOINT_DB_URL=postgresql://sparkflow:__strong_random_password__@postgres:5432/sparkflow_checkpoints

# ===========================================================================
# 4. Redis (in-network — docker service name)
# ===========================================================================
REDIS_URL=redis://redis:6379

# ===========================================================================
# 5. Cross-cutting service URLs (in-network)
# ===========================================================================
SPARKFLOW_API_URL=http://web:3001                       # Python → Node callback base
SEMOPS_API_URL=http://semops:2025                       # LOTUS semantic operators
SEARXNG_URL=http://searxng:8080                         # default web-search backend

# Shared Python↔Node callback secret. Same value used by both web (Node)
# and workflows-api / digest-worker (Python). Lives in this single file.
INTERNAL_CALLBACK_TOKEN=__rotate_per_env__              # openssl rand -hex 32

# SearXNG instance secret (substituted into the searxng container)
SEARXNG_SECRET=__rotate_per_env__                       # openssl rand -hex 32

# ===========================================================================
# 6. Browser-bundled URLs — embedded in the browser bundle by Next.js,
#    so they MUST be public URLs the user's browser can reach.
# ===========================================================================
# LangGraph — NOT in docker compose; runs separately via `langgraph up`.
LANGGRAPH_API_URL=https://agent.yourcompany.com:8123
NEXT_PUBLIC_LANGGRAPH_API_URL=https://agent.yourcompany.com:8123

# Workflows API — IS in this compose (service `workflows-api`).
# Server-side: docker hostname.  Browser-side: must be public.
WORKFLOWS_API_URL=http://workflows-api:2027
NEXT_PUBLIC_WORKFLOWS_API_URL=https://workflows.yourcompany.com

# ===========================================================================
# 7. Workers (BullMQ + ARQ tunables)
# ===========================================================================
INGEST_WORKER_CONCURRENCY=4
INGEST_PER_USER_CONCURRENCY=2
DIGEST_WORKER_CONCURRENCY=4

# ===========================================================================
# 8. MinerU (PDF parser)
# ===========================================================================
MINERU_MODE=api                                         # 'api' or 'local'
MINERU_API_TOKEN=__your_mineru_token__

# ===========================================================================
# 9. Observability — LangSmith tracing (recommended in production)
# ===========================================================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=__your_langsmith_key__
LANGSMITH_PROJECT=sparkflow-langgraph
# Set on hosts behind a TLS-intercepting proxy whose CA isn't trusted
# by langgraph's outbound https calls. Leave commented otherwise.
# LANGGRAPH_DISABLE_SSL_VERIFY=1

# ===========================================================================
# 10. Corporate proxy + TLS-MITM (server only — harmless on open networks)
# ===========================================================================
# NO_PROXY: lists every docker service hostname so library-level proxy
# code (HTTP_PROXY auto-injected by ~/.docker/config.json) skips
# inter-container traffic. Append your corporate intranet domains.
#
# WATCH OUT: corp LLM endpoints (e.g. an internal MiniMax / DeepSeek relay
# at https://*.rnd.huawei.com/...) MUST be listed here too. Otherwise the
# openai SDK's httpx client routes the call through the public HTTP_PROXY,
# which refuses CONNECT to intranet hosts and surfaces as
#   litellm.InternalServerError: OpenAIException - Connection error.
# after a ~78 s TCP wait. Affects semops (litellm path) but NOT chat
# (langchain path), so the failure looks selective and isolated.
# Use a leading dot to cover every subdomain at once (httpx supports it).
NO_PROXY=localhost,127.0.0.1,postgres,redis,searxng,semops,web,workflows-api,ingest-worker,digest-worker,migrate,.huawei.com
no_proxy=localhost,127.0.0.1,postgres,redis,searxng,semops,web,workflows-api,ingest-worker,digest-worker,migrate,.huawei.com

# Corporate CA bundle — paired with the bind-mount of ./ca-certificates.crt
# onto /etc/ssl/certs/ca-certificates.crt in docker-compose.server.yml.
# These three vars cover every TLS code path in the stack:
#   SSL_CERT_FILE       — Python ssl module / OpenSSL CLI
#   REQUESTS_CA_BUNDLE  — `requests` and `httpx`
#   CURL_CA_BUNDLE      — libcurl
# Safe to leave as-is on non-MITM hosts (it's the standard system path).
#
# Corp BYOK providers (e.g. AI4News at ai4news.rnd.huawei.com) are signed by
# private roots that NO public bundle ships. Run this once after `cp .env.example
# .env` on a corp host, before `docker compose up`:
#   ./scripts/setup-corp-ca.sh
# It fetches each corp host's chain, appends the intermediate + root to
# ./ca-certificates.crt, and dedupes. Idempotent. See the script header for
# how to add a new host.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
