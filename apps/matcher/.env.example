# ============================================
# SparkFlow Matcher Service Configuration
# ============================================

# Server
PORT=2025

# Xinference (LLM for LOTUS semantic matching)
XINFERENCE_BASE_URL=http://localhost:9997/v1
XINFERENCE_MODEL=Qwen3-Instruct
XINFERENCE_API_KEY=not-needed

# OpenAI API (fallback for some operations)
OPENAI_API_KEY=your-openai-api-key

# Query optimizer (OpenAI Structured Outputs for BU query merging/clarification)
ENABLE_MATCHER_QUERY_OPTIMIZER=true
MATCHER_QUERY_OPTIMIZER_MODEL=gpt-4o-2024-08-06
MATCHER_QUERY_OPTIMIZER_API_KEY=
