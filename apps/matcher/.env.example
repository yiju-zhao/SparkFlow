# ============================================
# SparkFlow Matcher Service Configuration
# ============================================

# Server
PORT=2025

# Database (PostgreSQL)
# Required: Must point to the same database as the web app
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://sparkflow:sparkflow@localhost:5432/sparkflow

# S3/MinIO Storage (for query files)
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sparkflow

# Xinference (LLM for LOTUS semantic matching)
XINFERENCE_BASE_URL=http://localhost:9997/v1
XINFERENCE_MODEL=Qwen3-Instruct
XINFERENCE_API_KEY=not-needed

# OpenAI API (fallback for some operations)
OPENAI_API_KEY=your-openai-api-key
