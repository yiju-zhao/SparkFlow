# ===========================================================================
# SparkFlow LangGraph — PRODUCTION environment
# ===========================================================================
# Copy to .env on the production server:
#   cp .env.production.example .env
#
# Loaded by docker compose for: workflows-api, digest-worker. Each of
# those services lists BOTH this file AND apps/web/.env in env_file:
#
#   env_file:
#     - ./apps/web/.env        # shared: INTERNAL_CALLBACK_TOKEN, POSTGRES_*, etc.
#     - ./apps/langgraph/.env  # langgraph-specific (this file)
#
# Compose merges later files over earlier ones, so anything you put here
# overrides the apps/web/.env value of the same key. Keep this file
# narrow — only langgraph-specific config belongs here.
#
# Cross-cutting vars (INTERNAL_CALLBACK_TOKEN, DATABASE_URL, REDIS_URL,
# SEMOPS_API_URL, SEARXNG_URL, SPARKFLOW_API_URL → http://web:3001)
# already live in apps/web/.env — DON'T duplicate them.

# ---------------------------------------------------------------------------
# LangGraph checkpointer DB — separate database from the main app DB
# ---------------------------------------------------------------------------
# Persists thread state / interrupts / resumes. Use a dedicated DB or
# schema so checkpoint churn doesn't fight the main DB's vacuum schedule.
CHECKPOINT_DB_URL=postgresql://sparkflow:__strong_random_password__@postgres:5432/sparkflow_checkpoints

# ---------------------------------------------------------------------------
# Daily-Digest ARQ worker tunables
# ---------------------------------------------------------------------------
DIGEST_WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Observability — LangSmith tracing (recommended in production)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=__your_langsmith_key__
LANGSMITH_PROJECT=sparkflow-langgraph
# Set on hosts behind a TLS-intercepting proxy whose CA isn't trusted
# by langgraph's outbound https calls. Leave commented otherwise.
# LANGGRAPH_DISABLE_SSL_VERIFY=1
