# Optional override consumed by `langgraph up -d docker-compose.override.yml`.
# Used on hosts that need extras (CA bundle, custom DNS, etc.) without
# rebuilding the image.
#
# Activate on a host:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   make up
#
# (apps/agent/Makefile auto-attaches the file with `-d` when it exists.)
#
# ─────────────────────────────────────────────────────────────────────
# Why mount the CA at runtime instead of baking it into the Dockerfile:
#  * Different hosts trust different CAs (corp proxy vs. clean cloud).
#  * The langgraph-api base image is shared upstream — patching it per
#    host fragments cache and forces rebuilds.
#  * Volume + env covers every Python TLS client without code changes.
# ─────────────────────────────────────────────────────────────────────

# Anchor the CA configuration so we don't repeat it across services.
x-ca-bundle: &ca-bundle
  volumes:
    # Mount the host CA bundle into the canonical Debian location.
    - ./ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro
  environment:
    # Three env vars cover everything Python touches:
    #   SSL_CERT_FILE       — Python `ssl` module (httpx, openai, asyncpg, …)
    #   REQUESTS_CA_BUNDLE  — `requests` library (langchain, tavily, …)
    #   CURL_CA_BUNDLE      — libcurl (anything shelled out via curl)
    SSL_CERT_FILE: /etc/ssl/certs/ca-certificates.crt
    REQUESTS_CA_BUNDLE: /etc/ssl/certs/ca-certificates.crt
    CURL_CA_BUNDLE: /etc/ssl/certs/ca-certificates.crt
    # Bind inside the container; Docker port mapping handles external access.
    LANGGRAPH_API_HOST: 0.0.0.0

services:
  # The LangGraph API server (runs the three graphs).
  langgraph-api:
    <<: *ca-bundle

  # ARQ digest worker (apps/agent/Dockerfile.worker). Same corp network,
  # so it needs the same trust anchors when it calls back to apps/web or
  # any external service. Uncomment if your compose stack runs the
  # digest-worker as a sibling service.
  # digest-worker:
  #   <<: *ca-bundle
