# OpenAI API
OPENAI_API_KEY=your_openai_key_here

# Google AI API (for Gemini models)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# RAGFlow API
RAGFLOW_API_KEY=your_ragflow_api_key_here
RAGFLOW_BASE_URL=http://localhost:9380

# LangGraph Checkpoint Database (for persistent agent memory)
CHECKPOINT_DB_URL=postgresql://sparkflow:sparkflow@localhost:5433/sparkflow_checkpoints

# LANGSMITH
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Query Optimization (set to "false" to disable)
ENABLE_PROMPT_OPTIMIZER=true

# Hub Agent Configuration
HUB_AGENT_MODEL_PROVIDER=openai
HUB_AGENT_MODEL_NAME=gpt-4o-mini

# Hub Agent Database (uses same PostgreSQL as web app)
DATABASE_URL=postgresql://sparkflow:sparkflow@localhost:5433/sparkflow
