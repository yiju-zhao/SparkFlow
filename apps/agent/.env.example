# ===========================================================================
# SparkFlow Agent — DEVELOPMENT environment
# ===========================================================================
# Copy to .env for local dev:
#   cp .env.example .env
#
# Assumed setup:
#   • postgres + redis running via apps/web `docker compose up -d`
#   • Next.js running on the host (port 3001)
#   • This agent + `make serve` running on the host
#
# For production deployment see .env.production.example.

# ---------------------------------------------------------------------------
# SparkFlow Web API (the agent calls back here for source content,
# search endpoints, and digest section completion callbacks)
# ---------------------------------------------------------------------------
SPARKFLOW_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# SemOps service (semantic ranking — `apps/semops`, port 2025)
# ---------------------------------------------------------------------------
SEMOPS_API_URL=http://localhost:2025

# ---------------------------------------------------------------------------
# Internal Python→Node callback secret. MUST match apps/web/.env.
# ---------------------------------------------------------------------------
INTERNAL_CALLBACK_TOKEN=dev_callback_token              # openssl rand -hex 32

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# Main SparkFlow DB — used by embedding backfill scripts under
# apps/agent/scripts/. Must match apps/web/.env's DATABASE_URL.
DATABASE_URL=postgresql://sparkflow:sparkflow@localhost:5433/sparkflow

# Redis — shared with the web app's BullMQ queue. Used by ARQ digest worker.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Research Hub Agent
# ---------------------------------------------------------------------------
# GenAI Toolbox MCP server — backs the hub's SQL tools.
TOOLBOX_SERVER_URL=http://localhost:5000/mcp

# ---------------------------------------------------------------------------
# Web Search backend
# ---------------------------------------------------------------------------
# SearXNG is the default — no API key needed. Point at the running
# instance (host port 8888 by default).
SEARXNG_URL=http://localhost:8888
# Tavily is BYOK only — users provide their own keys via Settings UI.
# There is intentionally no TAVILY_API_KEY env fallback.

# ---------------------------------------------------------------------------
# WeChat Database (optional — leave blank to disable)
# ---------------------------------------------------------------------------
WECHAT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Daily-Digest ARQ worker tunables
# ---------------------------------------------------------------------------
DIGEST_WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Observability — LangSmith tracing (optional)
# ---------------------------------------------------------------------------
# All four are needed for traces to land in the right project. The API
# key alone is silent without LANGSMITH_TRACING. Uncomment to enable.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=sparkflow-agent
# Set when behind a TLS-intercepting corporate proxy and your CA isn't
# trusted by langgraph's outbound calls; off in normal dev.
# LANGGRAPH_DISABLE_SSL_VERIFY=1
