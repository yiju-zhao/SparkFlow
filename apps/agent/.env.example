# ============================================
# SparkFlow Agent — Environment Variables
# ============================================
# Copy to .env and fill in your values.

# ============================================
# SparkFlow Web API
# ============================================
# The agent calls back to the Next.js frontend for source content,
# search endpoints, and digest section completion callbacks.
SPARKFLOW_API_URL=http://localhost:3001

# ============================================
# SemOps (operator library)
# ============================================
# Workflows (search, matcher, daily_digest) POST to
# $SEMOPS_API_URL/api/operators/rank for semantic ranking.
SEMOPS_API_URL=http://localhost:2025

# ============================================
# Digest Internal Callback
# ============================================
# Shared secret for authenticating the Python→Node callback when a
# digest section completes. Python sends it as X-Internal-Token;
# Node's /api/digest/sections/{id}/complete rejects mismatched requests.
# Generate: openssl rand -hex 32
# MUST match the same env in apps/web/.env.
INTERNAL_CALLBACK_TOKEN=change_me_openssl_rand_hex_32

# ============================================
# Databases
# ============================================
# Main SparkFlow DB — target for the embedding backfill scripts
# (apps/agent/scripts/backfill_*.py). Must match apps/web .env.
DATABASE_URL=postgresql://sparkflow:sparkflow@localhost:5433/sparkflow

# LangGraph checkpoints. When running in Docker, use host.docker.internal.
CHECKPOINT_DB_URL=postgresql://sparkflow:sparkflow@localhost:5433/sparkflow_checkpoints

# ============================================
# Research Hub Agent
# ============================================
# GenAI Toolbox MCP server — backs the 19 hub SQL tools
# (search_conferences, search_sessions, etc.). Point at a running
# Toolbox instance configured with apps/toolbox/tools.yaml.
TOOLBOX_SERVER_URL=http://localhost:5000/mcp

# ============================================
# Deep Research / Web Search
# ============================================
# Tavily API key for web search tool (required for web source type).
# Get one at https://tavily.com
TAVILY_API_KEY=

# ============================================
# WeChat Database (optional)
# ============================================
# External Postgres for WeChat article search (hub + search agents).
# Leave empty if you don't use WeChat features.
WECHAT_DATABASE_URL=

# ============================================
# Observability (optional)
# ============================================
# LangSmith tracing — set to enable trace logging.
LANGSMITH_API_KEY=

# ============================================
# Daily-Digest ARQ Worker
# ============================================
# Redis instance shared with the web app's BullMQ queue.
REDIS_URL=redis://localhost:6379

# Max digest sections this worker process handles concurrently.
DIGEST_WORKER_CONCURRENCY=4
