# ===========================================================================
# SparkFlow Agent — PRODUCTION environment
# ===========================================================================
# Copy to .env on the production server:
#   cp .env.production.example .env
#
# Used by:
#   • apps/web docker compose `prod` profile (service `workflows-api`,
#     `digest-worker`) which sets `env_file: ../agent/.env`.
#   • langgraph-api container (built separately via `langgraph up` from
#     apps/agent) which reads `env: .env` per langgraph.json.
#
# Compose injects in-network REDIS_URL (redis://redis:6379) and the
# in-container DATABASE_URL on the workflows-api service. Values listed
# below are still read by anything that runs OUTSIDE compose (e.g.
# langgraph-api container, ad-hoc backfill scripts on the host).
#
# !!! IMPORTANT !!! Rotate INTERNAL_CALLBACK_TOKEN per environment, and
# ensure it matches apps/web/.env exactly.

# ---------------------------------------------------------------------------
# SparkFlow Web API (in-network from compose, public via reverse proxy
# from langgraph-api / scripts on host).
# ---------------------------------------------------------------------------
# Compose default for workflows-api / digest-worker is `http://web:3001`.
# Override here if your setup differs (e.g. langgraph-api outside compose).
SPARKFLOW_API_URL=http://web:3001

# ---------------------------------------------------------------------------
# SemOps service — usually outside this compose. Point at its real host.
# ---------------------------------------------------------------------------
SEMOPS_API_URL=https://semops.yourcompany.com

# ---------------------------------------------------------------------------
# Internal Python→Node callback secret. MUST match apps/web/.env.
# ---------------------------------------------------------------------------
INTERNAL_CALLBACK_TOKEN=__rotate_per_env__              # openssl rand -hex 32

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# In compose, workflows-api gets DATABASE_URL injected to the docker
# service hostname. langgraph-api / host scripts use this value directly.
DATABASE_URL=postgresql://sparkflow:__strong_random_password__@postgres:5432/sparkflow

# LangGraph checkpointer DB — persists thread state / interrupts / resumes.
# `langgraph up` auto-provisions a `langgraph-postgres` sibling by default;
# set this to point checkpoints at your own Postgres instead (recommended in
# prod for backups + cross-deployment durability). Use a dedicated DB or
# schema so checkpoint churn doesn't fight the main DB's vacuum schedule.
CHECKPOINT_DB_URL=postgresql://sparkflow:__strong_random_password__@postgres:5432/sparkflow_checkpoints

# Redis — workflows-api / digest-worker get redis://redis:6379 injected
# by compose. Outside compose, set to your real broker.
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Research Hub Agent
# ---------------------------------------------------------------------------
# Toolbox MCP — usually a separate container. Point at its actual host.
TOOLBOX_SERVER_URL=http://toolbox:5000/mcp

# ---------------------------------------------------------------------------
# Web Search backend
# ---------------------------------------------------------------------------
# SearXNG is the default — point at the deployed instance reachable
# from inside the docker network (or via reverse proxy).
SEARXNG_URL=http://searxng:8080
# Tavily is BYOK only (users provide their own keys); no env fallback.

# ---------------------------------------------------------------------------
# WeChat Database (optional — leave blank to disable)
# ---------------------------------------------------------------------------
WECHAT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Daily-Digest ARQ worker tunables
# ---------------------------------------------------------------------------
DIGEST_WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Corporate CA bundle (containers running behind TLS-intercepting proxy)
# ---------------------------------------------------------------------------
# httpx / requests / curl all read different env vars for the CA bundle
# path. Set ALL THREE to the path of the mounted CA bundle inside the
# container. Path here is the container-side location — see
# apps/agent/Dockerfile.* and apps/agent/docker-compose.override.yml.example
# for the corresponding mount.
REQUESTS_CA_BUNDLE=/mnt/ca-certificates.crt
SSL_CERT_FILE=/mnt/ca-certificates.crt
CURL_CA_BUNDLE=/mnt/ca-certificates.crt

# ---------------------------------------------------------------------------
# Observability — LangSmith tracing (recommended in production)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=__your_langsmith_key__
LANGSMITH_PROJECT=sparkflow-agent
# Set on hosts behind a TLS-intercepting proxy whose CA isn't trusted
# by langgraph's outbound https calls. Leave commented otherwise.
# LANGGRAPH_DISABLE_SSL_VERIFY=1
