# ===========================================================================
# SparkFlow Web — PRODUCTION environment
# ===========================================================================
# Copy to .env on the production server:
#   cp .env.production.example .env
#
# Used by the docker compose `prod` profile:
#   docker compose --profile prod up -d --build
#
# Compose injects the in-network DATABASE_URL and REDIS_URL via docker
# service hostnames at runtime (postgres:5432 / redis:6379) — those are
# NOT read from this file by the web container. POSTGRES_* below ARE
# read by compose to build that DATABASE_URL.
#
# !!! IMPORTANT !!! Rotate every secret per environment:
#   • NEXTAUTH_SECRET, API_KEY_ENCRYPTION_SECRET — fresh `openssl rand -base64 32`
#   • POSTGRES_PASSWORD — strong random password, NOT `sparkflow`
#   • INTERNAL_CALLBACK_TOKEN — fresh `openssl rand -hex 32`

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=__rotate_per_env__                      # openssl rand -base64 32
NEXTAUTH_URL=https://your-public-domain.com             # the URL your users hit
ADMIN_EMAILS=admin@yourcompany.com
API_KEY_ENCRYPTION_SECRET=__rotate_per_env__            # openssl rand -base64 32

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# Compose builds DATABASE_URL from these for the in-network connection
# (postgres service hostname). Outside compose, override DATABASE_URL.
POSTGRES_USER=sparkflow
POSTGRES_PASSWORD=__strong_random_password__
POSTGRES_DB=sparkflow

# Optional external WeChat Postgres
WECHAT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis — managed by compose (redis://redis:6379), no override needed.
# ---------------------------------------------------------------------------
INGEST_WORKER_CONCURRENCY=4
INGEST_PER_USER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Backend services
# ---------------------------------------------------------------------------
# Server-side URLs reach services across the docker network OR via reverse
# proxy. The `NEXT_PUBLIC_*` variants ARE EMBEDDED IN THE BROWSER BUNDLE,
# so they MUST be URLs the user's browser can reach (public domain or LAN IP).

# LangGraph — NOT in this docker-compose; runs separately via `langgraph up`
# from apps/langgraph (default port 8123, the upstream LangGraph CLI default).
# Point this at wherever it actually lives in prod — typically a reverse
# proxy fronting :8123, or the LAN host:port directly.
LANGGRAPH_API_URL=https://agent.yourcompany.com:8123
NEXT_PUBLIC_LANGGRAPH_API_URL=https://agent.yourcompany.com:8123

# Workflows API — IS in the prod profile (service `workflows-api`).
# Server-side: docker service hostname.
# Browser-side: must be public.
WORKFLOWS_API_URL=http://workflows-api:2027
NEXT_PUBLIC_WORKFLOWS_API_URL=https://workflows.yourcompany.com

# Shared secret for the Python→Node digest callback.
# MUST match apps/langgraph/.env.
INTERNAL_CALLBACK_TOKEN=__rotate_per_env__              # openssl rand -hex 32

# ---------------------------------------------------------------------------
# MinerU
# ---------------------------------------------------------------------------
# In production, prefer the hosted API mode unless you run a MinerU instance.
MINERU_MODE=api
MINERU_API_TOKEN=__your_mineru_token__

# ---------------------------------------------------------------------------
# docker compose tunables
# ---------------------------------------------------------------------------
# Host port to expose the web container on (mapped to 3001 inside).
WEB_PORT=3001
# Host port for the workflows-api container (mapped to 2027 inside).
WORKFLOWS_PORT=2027
