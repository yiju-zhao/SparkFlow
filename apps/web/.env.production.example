# ===========================================================================
# SparkFlow Web — PRODUCTION environment
# ===========================================================================
# Copy to .env on the production server:
#   cp .env.production.example .env
#
# Loaded by docker compose (`prod` profile) for: postgres, ingest-worker,
# migrate, web. Also loaded by workflows-api / digest-worker (via env_file
# list) so cross-cutting vars like INTERNAL_CALLBACK_TOKEN live ONLY here
# and don't need to be duplicated in apps/langgraph/.env.
#
# Compose injects these values directly via env_file — there is NO
# ${...} substitution in the compose file for app config, so the value
# you write here is exactly what the container sees. No surprises.
#
# For LOCAL `npm run dev` on the host, override DATABASE_URL/REDIS_URL
# in apps/web/.env.local (gitignored, picked up by Next.js but ignored
# by docker).
#
# !!! IMPORTANT !!! Rotate every secret per environment:
#   • NEXTAUTH_SECRET, API_KEY_ENCRYPTION_SECRET — fresh `openssl rand -base64 32`
#   • POSTGRES_PASSWORD — strong random, NOT `sparkflow`
#   • INTERNAL_CALLBACK_TOKEN — fresh `openssl rand -hex 32`

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=__rotate_per_env__                      # openssl rand -base64 32
NEXTAUTH_URL=https://your-public-domain.com             # the URL your users hit
ADMIN_EMAILS=admin@yourcompany.com
API_KEY_ENCRYPTION_SECRET=__rotate_per_env__            # openssl rand -base64 32

# ---------------------------------------------------------------------------
# Postgres + Database URL
# ---------------------------------------------------------------------------
# POSTGRES_USER/PASSWORD/DB are read by the postgres image to initialize
# the cluster on first boot. DATABASE_URL is what every app talks to —
# write it with the docker service hostname (`postgres`) so containers
# resolve it via the compose network.
POSTGRES_USER=sparkflow
POSTGRES_PASSWORD=__strong_random_password__
POSTGRES_DB=sparkflow
DATABASE_URL=postgresql://sparkflow:__strong_random_password__@postgres:5432/sparkflow

# Optional external WeChat Postgres — leave blank to disable
WECHAT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis (in-network — docker service name)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
INGEST_WORKER_CONCURRENCY=4
INGEST_PER_USER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Backend services
# ---------------------------------------------------------------------------
# Server-side URLs reach services across the docker network OR via reverse
# proxy. The `NEXT_PUBLIC_*` variants ARE EMBEDDED IN THE BROWSER BUNDLE,
# so they MUST be URLs the user's browser can reach.

# LangGraph — NOT in docker compose; runs separately via `langgraph up`
# from apps/langgraph (default port 8123). Point at wherever it lives —
# typically a reverse proxy fronting :8123, or LAN host:port.
LANGGRAPH_API_URL=https://agent.yourcompany.com:8123
NEXT_PUBLIC_LANGGRAPH_API_URL=https://agent.yourcompany.com:8123

# Workflows API — IS in the prod profile (service `workflows-api`).
# Server-side: docker service hostname.  Browser-side: must be public.
WORKFLOWS_API_URL=http://workflows-api:2027
NEXT_PUBLIC_WORKFLOWS_API_URL=https://workflows.yourcompany.com

# ---------------------------------------------------------------------------
# Cross-cutting: Python↔Node callback secret
# ---------------------------------------------------------------------------
# Lives ONLY in this file — the langgraph services pick it up via the
# env_file list in docker-compose. No duplication, no sync risk.
INTERNAL_CALLBACK_TOKEN=__rotate_per_env__              # openssl rand -hex 32

# ---------------------------------------------------------------------------
# Cross-cutting: SemOps + SearXNG (consumed by both web and langgraph)
# ---------------------------------------------------------------------------
SEMOPS_API_URL=http://semops:2025
SEARXNG_URL=http://searxng:8080

# ---------------------------------------------------------------------------
# MinerU
# ---------------------------------------------------------------------------
MINERU_MODE=api                                         # 'api' or 'local'
MINERU_API_TOKEN=__your_mineru_token__

# ---------------------------------------------------------------------------
# docker compose port mappings (host port → container port)
# ---------------------------------------------------------------------------
WEB_PORT=3001
WORKFLOWS_PORT=2027
POSTGRES_PORT=5433
REDIS_PORT=6379
SEARXNG_PORT=8888
SEMOPS_PORT=2025
