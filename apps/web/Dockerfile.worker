# Ingest worker image — runs `npm run worker:ingest` (tsx workers/ingest.ts).
# Separate from the main Dockerfile because the worker does NOT need a
# Next.js build: it only consumes node_modules, source TS, and Prisma client.
FROM node:24 AS base
WORKDIR /app
ENV NODE_ENV=production

FROM base AS deps
# Skip SSL verification matches the pattern in the main Dockerfile.
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
COPY package.json package-lock.json* ./
COPY prisma ./prisma
# Use pnpm via corepack instead of `npm ci`. npm 11 (shipped with
# node:24) reliably crashes mid-install with "Exit handler never
# called!" on this lockfile — even with --ignore-scripts and a 4GB
# heap. pnpm's installer is a different code path entirely and is also
# 3-5× faster on cold caches. --no-frozen-lockfile lets pnpm install
# from package.json without needing to commit a pnpm-lock.yaml.
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --no-frozen-lockfile --ignore-scripts && pnpm exec prisma generate

FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/prisma ./prisma
# Copy only what the worker needs — not the whole app. `tsx` resolves imports
# at runtime, so we do need the source TS files it touches.
COPY package.json ./
COPY tsconfig.json ./
COPY lib ./lib
COPY workers ./workers
# Next.js app/ and components/ are not needed by the worker but are shallow
# to copy and keep the image coherent with the main image's CWD layout.
CMD ["npm", "run", "worker:ingest"]
