# SparkFlow Web App Environment Variables
# Copy to .env.local and fill in your values

# =============================================
# 1. Authentication
# =============================================
NEXTAUTH_SECRET=your_super_secret_jwt_key_change_in_production   # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3001
ADMIN_EMAILS=admin@example.com                                    # comma-separated, auto-promoted on login

# BYOK encryption key for user API keys (openssl rand -base64 32)
API_KEY_ENCRYPTION_SECRET=your_encryption_secret_here

# =============================================
# 2. Databases
# =============================================
# Primary (Prisma)
POSTGRES_USER=sparkflow
POSTGRES_PASSWORD=sparkflow
POSTGRES_DB=sparkflow
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sparkflow:sparkflow@localhost:5433/sparkflow

# WeChat Articles (external, read-only — powers Research Hub's
# /explore/social-media/wechat/* listing + article pages).
# Read by apps/web/lib/wechat-db.ts.
WECHAT_DATABASE_URL=postgresql://user:pass@host:5432/wechat_db

# Redis (BullMQ queue broker for the wiki-ingest worker).
# Started by docker compose (service `redis`, port 6379).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Concurrency caps for the ingest worker. Total jobs in flight across the
# worker process and per-user fairness cap (prevents one user hogging workers).
INGEST_WORKER_CONCURRENCY=4
INGEST_PER_USER_CONCURRENCY=2

# =============================================
# 3. Backend Services
# =============================================
# When apps/agent and apps/semops run on the host, leave URLs as `localhost:*`.
# When the web container needs to reach a service on the host (docker compose
# `prod` profile, macOS), use `http://host.docker.internal:<port>` instead.
# When all services share one docker-compose network, use the docker service
# name (e.g. `http://langgraph-api:2024`).

# LangGraph Agent (port 2024). Started via `langgraph dev` or `langgraph up`
# from apps/agent. Hosts the notebook, hub, and deep_research surface graphs.
LANGGRAPH_API_URL=http://localhost:2024
# Server-side fallback used by /api/langgraph/[...path] and /api/chat
# when LANGGRAPH_API_URL is unset. Keep both pointing at the same host.
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2024

# Workflows server (apps/agent/server/app.py FastAPI, port 2027).
# Started separately from langgraph: `uvicorn server.app:app --host 0.0.0.0 --port 2027`
# from apps/agent. Hosts /v1/workflows/matcher/jobs/* and
# /v1/workflows/daily_digest/sections/{id}/generate.
# Server-side routes read WORKFLOWS_API_URL; browser-bundled matcher client
# reads NEXT_PUBLIC_WORKFLOWS_API_URL (so it must be reachable from the browser).
WORKFLOWS_API_URL=http://localhost:2027
NEXT_PUBLIC_WORKFLOWS_API_URL=http://localhost:2027

# Shared secret for the Python→Node digest completion callback.
# Python workflow sends it as X-Internal-Token; Node's
# /api/digest/sections/{id}/complete rejects mismatched requests.
# Generate: openssl rand -hex 32
# MUST match the same env in apps/agent/.env.
INTERNAL_CALLBACK_TOKEN=change_me_openssl_rand_hex_32

# =============================================
# 4. MinerU (PDF Parsing)
# =============================================
MINERU_MODE=local                    # "local" or "api"
MINERU_LOCAL_URL=http://localhost:8000
MINERU_API_TOKEN=                    # required when MINERU_MODE=api

# =============================================
# 5. Optional / Operations
# =============================================
# Port the Next.js container binds when running under the docker compose
# `prod` profile (`docker compose --profile prod up -d`). Ignored on host.
WEB_PORT=3001

# Path to a Python interpreter for the WeChat embedding backfill admin script
# (apps/web/lib/services/wechat-embedding-job.ts). Defaults to "python3".
# PYTHON_BIN=python3
