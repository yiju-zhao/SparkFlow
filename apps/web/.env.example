# ===========================================================================
# SparkFlow Web — DEVELOPMENT environment
# ===========================================================================
# Copy to .env (or .env.local) for local dev:
#   cp .env.example .env.local
#
# Assumed setup:
#   • postgres + redis running via `docker compose up -d` (default profile)
#   • Next.js running on the host via `npm run dev`
#   • LangGraph + workflows-api running on the host (apps/langgraph: `make dev` and `make serve`)
#
# For production deployment see .env.production.example.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=dev_secret_change_me                    # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3001
ADMIN_EMAILS=admin@example.com                          # comma-separated
API_KEY_ENCRYPTION_SECRET=dev_byok_key_change_me        # openssl rand -base64 32

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# Postgres runs in docker compose; host accesses via the mapped port.
POSTGRES_USER=sparkflow
POSTGRES_PASSWORD=sparkflow
POSTGRES_DB=sparkflow
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sparkflow:sparkflow@localhost:5433/sparkflow

# Optional: external WeChat Postgres for /explore/social-media/wechat/*.
# Leave blank if you don't need WeChat features.
WECHAT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis (BullMQ + ARQ queue broker)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Wiki-ingest worker concurrency
INGEST_WORKER_CONCURRENCY=4
INGEST_PER_USER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Backend services (all on host)
# ---------------------------------------------------------------------------
# LangGraph (port 2024) — `cd apps/langgraph && make dev`
LANGGRAPH_API_URL=http://localhost:2024
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2024

# Workflows API / FastAPI (port 2027) — `cd apps/langgraph && make serve`
# Hosts /v1/workflows/matcher/jobs/*, /v1/workflows/daily_digest/*,
# /v1/workflows/search.
WORKFLOWS_API_URL=http://localhost:2027
NEXT_PUBLIC_WORKFLOWS_API_URL=http://localhost:2027

# Shared secret for the Python→Node digest completion callback.
# MUST match apps/langgraph/.env.
INTERNAL_CALLBACK_TOKEN=dev_callback_token                # openssl rand -hex 32

# ---------------------------------------------------------------------------
# MinerU (PDF parsing)
# ---------------------------------------------------------------------------
MINERU_MODE=local                                         # "local" or "api"
MINERU_LOCAL_URL=http://localhost:8000
MINERU_API_TOKEN=                                         # required when MINERU_MODE=api

# ---------------------------------------------------------------------------
# Optional / admin scripts
# ---------------------------------------------------------------------------
# Path to a Python interpreter for the WeChat embedding backfill script
# (apps/web/lib/services/wechat-embedding-job.ts). Defaults to "python3".
# PYTHON_BIN=python3
