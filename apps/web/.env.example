# SparkFlow Web App Environment Variables
# Copy to .env and fill in your values

# ============================================
# NextAuth (Authentication)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secret_jwt_key_change_in_production
NEXTAUTH_URL=http://localhost:3001

# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=sparkflow
POSTGRES_PASSWORD=sparkflow
POSTGRES_DB=sparkflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================
# LangGraph Agent Backend
# ============================================
# Must be reachable from the web app server/browser. Do not use localhost if
# LangGraph runs on a different machine.
NEXT_PUBLIC_LANGGRAPH_API_URL=http://your-langgraph-host:8123

# ============================================
# Matcher Service Backend
# ============================================
NEXT_PUBLIC_MATCHER_API_URL=http://localhost:2025

# ============================================
# MineRU (PDF Parsing)
# ============================================
MINERU_MODE=local          # "local" or "api"
MINERU_LOCAL_URL=http://localhost:8000
MINERU_API_TOKEN=          # Required when MINERU_MODE=api

# ============================================
# PageIndex
# ============================================
PAGEINDEX_MODEL=gpt-4o-2024-11-20

# ============================================
# AI Model Configuration (for settings UI)
# Note: API keys are in agent/.env and matcher/.env
# ============================================
# Available OpenAI models (comma-separated)
OPENAI_MODELS=gpt-4o-mini,gpt-4.1,gpt-5.2
# Available Google/Gemini models (comma-separated)
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-1.5-flash
# Default model (for new users)
DEFAULT_MODEL_PROVIDER=google
DEFAULT_MODEL_NAME=gemini-2.5-flash

# ============================================
# MCP Services
# ============================================
MCP_SERVER_URL=http://localhost:3108/mcp
